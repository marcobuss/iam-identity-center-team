{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "env": {
      "Type": "String"
    }
  },
  "Resources": {
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Join": [
            "",
            [
              "team-amplify-bucket-lambda-role",
              "-",
              {
                "Ref": "env"
              }
            ]
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "S3Permissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Action": [
                    "s3:ListAllMyBuckets",
                    "s3:PutBucketPolicy",
                    "s3:PutBucketVersioning"
                  ],
                  "Effect": "Allow",
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "PolicyName": "AmplifyPermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Action": [
                    "amplify:GetBackendEnvironment",
                    "amplify:ListApps"
                  ],
                  "Effect": "Allow",
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "PolicyName": "LogPermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${lambda}:log-stream:*",
                      {
                        "lambda": {
                          "Fn::Join": [
                            "",
                            [
                              "team-amplify-bucket-lambda-",
                              {
                                "Ref": "env"
                              }
                            ]
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Path": "/"
      }
    },
    "LambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Architectures": [
          "arm64"
        ],
        "Runtime": "python3.13",
        "FunctionName": {
          "Fn::Join": [
            "",
            [
              "team-amplify-bucket-lambda-",
              {
                "Ref": "env"
              }
            ]
          ]
        },
        "Environment": {
          "Variables": {
            "DEPLOYMENT_NAMESPACE": {
              "Ref": "env"
            }
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecutionRole",
            "Arn"
          ]
        },
        "Handler": "index.handler",
        "Description": "Enable versioning on the namespaced Amplify deployment bucket",
        "Timeout": 30,
        "Code": {
          "ZipFile": "import boto3\nimport cfnresponse\nimport logging\nimport os\nfrom botocore.config import Config\n\n\nlogger = logging.getLogger()\nlogger.setLevel(logging.INFO)\n\n\ndef get_boto3_config() -> Config:\n    return Config(user_agent_extra=\"team-idc\")\n\n\namplify = boto3.client('amplify')\ns3 = boto3.client('s3', config=get_boto3_config())\n\n\ndef handler(event, context):\n    if event.get('RequestType') == 'Delete':\n        cfnresponse.send(event, context, cfnresponse.SUCCESS, {'Data': 'Delete successful'})\n        return\n\n    namespace = os.environ['DEPLOYMENT_NAMESPACE']\n    app_name = f'TEAM-IDC-APP-{namespace}'\n    app_id = next((app['appId'] for app in amplify.list_apps()['apps'] if app['name'] == app_name), None)\n\n    if not app_id:\n        logger.error('Namespaced Amplify app was not found')\n        cfnresponse.send(event, context, cfnresponse.FAILED, {'Data': 'Amplify app not found'})\n        return\n\n    backend_env = amplify.get_backend_environment(appId=app_id, environmentName=namespace)\n    stack_name = backend_env['backendEnvironment']['stackName']\n    deployment_bucket = f'{stack_name}-deployment'\n\n    s3.put_bucket_versioning(\n        Bucket=deployment_bucket,\n        VersioningConfiguration={'Status': 'Enabled'}\n    )\n\n    logger.info('Enabled versioning on the namespaced Amplify deployment bucket')\n    cfnresponse.send(event, context, cfnresponse.SUCCESS, {'Data': 'Success'})\n"
        }
      }
    },
    "ConfigureAmplifyBucket": {
      "Type": "Custom::ConfigureAmplifyS3Bucket",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "LambdaFunction",
            "Arn"
          ]
        },
        "version": "0.2"
      }
    }
  }
}
