{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Custom AppSync resources for TEAM",
  "Metadata": {},
  "Parameters": {
    "AppSyncApiId": {
      "Type": "String",
      "Description": "The ID of the AppSync API associated with this project"
    },
    "AppSyncApiName": {
      "Type": "String",
      "Description": "The name of the AppSync API",
      "Default": "AppSyncSimpleTransform"
    },
    "env": {
      "Type": "String",
      "Description": "The Amplify environment name",
      "Default": "NONE"
    },
    "S3DeploymentBucket": {
      "Type": "String",
      "Description": "The S3 bucket containing deployment assets"
    },
    "S3DeploymentRootKey": {
      "Type": "String",
      "Description": "The deployment asset key prefix"
    }
  },
  "Resources": {
    "SessionActivityStateDataSource": {
      "Type": "AWS::AppSync::DataSource",
      "Properties": {
        "ApiId": { "Ref": "AppSyncApiId" },
        "Name": "SessionActivityStateNoneDataSource",
        "Type": "NONE"
      }
    },
    "PublishSessionActivityStateResolver": {
      "Type": "AWS::AppSync::Resolver",
      "Properties": {
        "ApiId": { "Ref": "AppSyncApiId" },
        "TypeName": "Mutation",
        "FieldName": "publishSessionActivityState",
        "DataSourceName": { "Fn::GetAtt": ["SessionActivityStateDataSource", "Name"] },
        "RequestMappingTemplate": "#if($util.authType() != \"IAM Authorization\")\n$util.unauthorized()\n#end\n$util.toJson({\"version\":\"2018-05-29\",\"payload\":$ctx.args.result})",
        "ResponseMappingTemplate": "$util.toJson($ctx.result)"
      }
    }
  },
  "Conditions": {
    "HasEnvironmentParameter": {
      "Fn::Not": [{ "Fn::Equals": [{ "Ref": "env" }, "NONE"] }]
    }
  },
  "Outputs": {
    "SessionActivityStateResolverName": {
      "Value": { "Ref": "PublishSessionActivityStateResolver" }
    }
  }
}
